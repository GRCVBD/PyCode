
QWidget
{
    background-color: transparent;
}

QLabel#copy_label
{
    border: none;
    background-color: #20d0ed;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    font-family: "Microsoft YaHei", sans-serif;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QLabel#label
{
    border: none;
    background-color: #20d0ed;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}


QLineEdit#input_edit
{
    background-color: #ffffff;
    color: #000000;
    border: none;
    font-size: 16px;
    font-family: "Microsoft YaHei", sans-serif;
    selection-background-color: #c6d9fe;
    selection-color: #000000;
}

QLineEdit:focus
{
    background-color: #FFFFFF;
}

QMenu
{
    background-color: #c6d9fe;
    width: 60px;
}

QMenu::item
{
    background-color: #c6d9fe;
    color: #000000;
}

QMenu::item:selected
{
    background-color: #20d0ed;
    color: #000000;
}

QMenu::separator
{
    height: 1px;
    background-color: #2a373e;
}
